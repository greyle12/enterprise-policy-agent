    {
      "code": "POLICY_RECHECK_REQUIRED",
      "description": "草稿制度快照已过期或制度版本发生变化，需要重新检查"
    },
    {
      "code": "IDEMPOTENCY_KEY_REQUIRED",
      "description": "提交操作没有提供幂等键"
    },
    {
      "code": "IDEMPOTENCY_KEY_CONFLICT",
      "description": "幂等键已被其他不同提交请求使用"
    },
    {
      "code": "ALREADY_SUBMITTED",
      "description": "草稿已经被提交"
