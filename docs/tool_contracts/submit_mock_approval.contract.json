{
  "tool_name": "submit_mock_approval",
  "version": "1.1",
  "implementation_status": "implemented_in_memory",
  "implementation_module": "app.tools.mock_approval_submission.MockApprovalSubmitter",
  "description": "仅在用户已经明确确认草稿后，模拟创建审批申请、冻结审批路线并写入最小审计事件。",
  "side_effect": "in_memory_mock_submission",
  "requires_explicit_submission_command": true,
  "accepted_submission_commands": [
    "提交",
    "提交审批",
    "提交申请",
    "正式提交",
    "确认提交",
    "确认提交审批"
  ],
  "persistence": {
    "backend": "in_memory",
    "survives_process_restart": false,
    "supports_multi_instance_consistency": false
  },
  "supported_application_types": [
    "purchase",
    "travel_reimbursement",
    "leave",
    "expense_reimbursement"
  ],
  "preconditions": [
    "draft必须由ApplicationDraftGenerator生成",
    "draft.status必须为confirmed",
    "draft.user_confirmed必须为true",
    "draft.confirmed_at必须存在",
    "draft.ready_for_confirmation必须为true",
    "draft不得缺少必填字段",
    "draft不得存在阻断性validation_issues",
    "draft不得缺少制度要求的材料",
    "draft必须存在完整审批路线",
    "调用用户必须与草稿申请人及创建人一致",
    "draft.audit_metadata.session_id必须与当前会话一致",
    "submission_idempotency_key必须存在且长度不少于8个字符"
  ],
  "security_rules": [
    "询问句、模糊表达或大模型推断不得触发提交",
    "确认草稿和提交审批必须是两个独立动作",
    "不得由大模型自行设置user_confirmed为true",
    "可信用户身份必须来自认证层或可信演示上下文",
    "不得提交其他用户或其他会话中的草稿",
    "不得绕过字段、材料、审批路线或阻断性校验",
    "相同幂等键必须返回首次提交结果，不得创建新申请",
    "同一草稿不得通过更换幂等键创建第二份审批申请",
    "并发重试只能创建一份审批申请",
    "审计记录不得包含草稿正文或敏感字段原文",
    "确认提交文本只记录SHA-256摘要",
    "所有提交和幂等重放都必须记录request_id、session_id和幂等键"
  ],
  "idempotency": {
    "workflow_key_source": "draft.audit_metadata.idempotency_key + draft_id + revision + submit",
    "scope": "process_memory",
    "duplicate_behavior": "return_first_submission_and_append_idempotent_replay_audit",
    "concurrency_control": "asyncio.Lock"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "draft",
      "confirmation_text",
      "user_context",
      "session_id",
      "request_id",
      "submission_idempotency_key"
    ],
    "properties": {
      "draft": {
        "type": "ApplicationDraft",
        "description": "当前会话checkpoint中的结构化草稿"
      },
      "confirmation_text": {
        "type": "string",
        "minLength": 1,
        "description": "用户本轮明确要求提交审批的原始文本"
      },
      "user_context": {
        "type": "DraftUserContext",
        "description": "来自可信身份层的当前调用用户"
      },
      "session_id": {
        "type": "string",
        "minLength": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1
      },
      "submission_idempotency_key": {
        "type": "string",
        "minLength": 8
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "success",
      "duplicate_submission",
      "submission_result",
      "approval_workflow",
      "audit_record",
      "storage_backend",
      "survives_process_restart"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "duplicate_submission": {
        "type": "boolean"
      },
      "submission_result": {
        "type": "object",
        "required": [
          "submission_id",
          "draft_id",
          "application_type",
          "status",
          "submitted_at",
          "submitted_by",
          "idempotency_key"
        ],
        "properties": {
          "submission_id": {
            "type": "string",
            "pattern": "^MOCK-(PUR|TRV|LEV|EXP)-[0-9]{8}-[A-F0-9]{12}$"
          },
          "draft_id": {
            "type": "string"
          },
          "application_type": {
            "type": "string",
            "enum": [
              "purchase",
              "travel_reimbursement",
              "leave",
              "expense_reimbursement"
            ]
          },
          "status": {
            "const": "approval_in_progress"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "submitted_by": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          }
        }
      },
      "approval_workflow": {
        "type": "object",
        "required": [
          "workflow_id",
          "current_step",
          "steps"
        ],
        "properties": {
          "workflow_id": {
            "type": "string"
          },
          "current_step": {
            "type": "integer",
            "minimum": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sequence",
                "approver",
                "display_name",
                "status"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "approver": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "waiting"
                  ]
                }
              }
            }
          }
        }
      },
      "audit_record": {
        "type": "object",
        "required": [
          "audit_id",
          "event",
          "session_id",
          "request_id",
          "draft_id",
          "draft_revision",
          "submission_id",
          "submission_idempotency_key",
          "actor_employee_id",
          "recorded_at",
          "confirmation_text_recorded",
          "confirmation_text_sha256",
          "duplicate_submission",
          "sensitive_fields_recorded"
        ],
        "properties": {
          "audit_id": {
            "type": "string"
          },
          "event": {
            "type": "string",
            "enum": [
              "submitted",
              "idempotent_replay"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "draft_id": {
            "type": "string"
          },
          "draft_revision": {
            "type": "integer",
            "minimum": 1
          },
          "submission_id": {
            "type": "string"
          },
          "submission_idempotency_key": {
            "type": "string"
          },
          "actor_employee_id": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "confirmation_text_recorded": {
            "const": true
          },
          "confirmation_text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "duplicate_submission": {
            "type": "boolean"
          },
          "sensitive_fields_recorded": {
            "const": false
          }
        }
      },
      "storage_backend": {
        "const": "in_memory"
      },
      "survives_process_restart": {
        "const": false
      }
    }
  },
  "error_codes": [
    "explicit_submission_required",
    "draft_owner_mismatch",
    "draft_creator_mismatch",
    "session_mismatch",
    "draft_not_confirmed",
    "confirmation_missing",
    "inconsistent_submission_state",
    "draft_not_ready",
    "missing_fields",
    "blocking_validation_issue",
    "missing_materials",
    "approval_route_incomplete",
    "approval_route_empty",
    "idempotency_conflict"
  ],
  "non_goals": [
    "不连接真实OA或企业审批系统",
    "不在服务重启后恢复提交记录",
    "不实现审批节点通过、驳回或进度推进",
    "不实现已提交申请撤回",
    "不实现跨进程或多实例幂等"
  ]
}
