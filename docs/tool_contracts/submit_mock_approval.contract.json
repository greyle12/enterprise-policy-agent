{
  "tool_name": "submit_mock_approval",
  "version": "1.0",
  "implementation_status": "contract_only",
  "description": "在用户已经明确确认且草稿满足提交条件时，将申请草稿模拟提交到审批流程，并返回正式申请编号、审批路线和审计信息。",
  "side_effect": "workflow_submission",
  "requires_user_confirmation": true,
  "supported_application_types": [
    "purchase",
    "travel_reimbursement",
    "leave",
    "expense_reimbursement"
  ],
  "preconditions": [
    "draft必须由create_application_draft工具生成",
    "draft.status必须为waiting_for_confirmation",
    "draft.confirmation.required必须为true",
    "用户必须通过明确意图完成确认",
    "confirmation.user_confirmed必须为true",
    "草稿不得存在阻断性的validation_issues",
    "草稿必须满足ready_for_submission条件",
    "提交人必须是申请人本人或具有合法代办权限的用户",
    "submission_idempotency_key必须存在",
    "相同幂等键不得创建多个正式申请"
  ],
  "security_rules": [
    "不得根据模糊表达推断用户已经确认",
    "不得由大模型自行设置user_confirmed为true",
    "可信用户身份必须来自认证层",
    "提交前必须验证草稿归属和调用人权限",
    "不得提交其他用户的草稿，除非存在经过验证的代办权限",
    "不得绕过材料完整性、余额、预算、金额或时间重叠检查",
    "敏感信息不得写入普通提交日志",
    "提交必须生成不可重复的正式申请编号",
    "所有提交结果都必须记录request_id、session_id和幂等键",
    "重复调用必须返回首次提交结果，而不是创建新申请"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "draft",
      "confirmation",
      "user_context",
      "session_id",
      "request_id",
      "submission_idempotency_key"
    ],
    "properties": {
      "draft": {
        "type": "object",
        "required": [
          "draft_id",
          "application_type",
          "status",
          "applicant",
          "application_data",
          "policy_snapshot",
          "required_approvers",
          "confirmation",
          "submission",
          "audit_metadata"
        ],
        "properties": {
          "draft_id": {
            "type": "string"
          },
          "application_type": {
            "type": "string",
            "enum": [
              "purchase",
              "travel_reimbursement",
              "leave",
              "expense_reimbursement"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting_for_confirmation"
            ]
          },
          "applicant": {
            "type": "object",
            "required": [
              "employee_id",
              "employee_name",
              "department"
            ],
            "properties": {
              "employee_id": {
                "type": "string"
              },
              "employee_name": {
                "type": "string"
              },
              "department": {
                "type": "string"
              }
            }
          },
          "application_data": {
            "type": "object"
          },
          "calculated_fields": {
            "type": "object"
          },
          "policy_snapshot": {
            "type": "object",
            "required": [
              "document_id",
              "version",
              "effective_date",
              "checked_at"
            ],
            "properties": {
              "document_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "effective_date": {
                "type": "string",
                "format": "date"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "missing_materials": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "validation_issues": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "required_approvers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confirmation": {
            "type": "object",
            "required": [
              "required",
              "user_confirmed",
              "confirmed_at"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "user_confirmed": {
                "type": "boolean"
              },
              "confirmed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "submission": {
            "type": "object",
            "required": [
              "submitted",
              "submission_id",
              "submitted_at"
            ],
            "properties": {
              "submitted": {
                "type": "boolean"
              },
              "submission_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "submitted_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "audit_metadata": {
            "type": "object"
          }
        }
      },
      "confirmation": {
        "type": "object",
        "required": [
          "confirmation_intent",
          "confirmation_text",
          "confirmed_by",
          "confirmed_at"
        ],
        "properties": {
          "confirmation_intent": {
            "type": "string",
            "enum": [
              "confirm"
            ]
          },
          "confirmation_text": {
            "type": "string",
            "description": "用户用于明确确认提交的原始文本"
          },
          "confirmed_by": {
            "type": "string",
            "description": "完成确认的员工编号"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "confirmation_channel": {
            "type": "string",
            "enum": [
              "chat",
              "web",
              "api"
            ],
            "default": "chat"
          }
        }
      },
      "user_context": {
        "type": "object",
        "required": [
          "employee_id",
          "employee_name",
          "department",
          "roles",
          "region"
        ],
        "properties": {
          "employee_id": {
            "type": "string"
          },
          "employee_name": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "min_items": 1
          },
          "region": {
            "type": "string"
          },
          "delegated_permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "session_id": {
        "type": "string"
      },
      "request_id": {
        "type": "string"
      },
      "submission_idempotency_key": {
        "type": "string",
        "min_length": 8,
        "description": "用于保证提交操作仅执行一次"
      },
      "simulate_failure": {
        "type": "boolean",
        "description": "仅用于本地测试工具异常和重试流程",
        "default": false
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "success",
      "submission_result",
      "approval_workflow",
      "audit_metadata"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "submission_result": {
        "type": "object",
        "required": [
          "submission_id",
          "draft_id",
          "application_type",
          "status",
          "submitted_at",
          "submitted_by",
          "duplicate_submission"
        ],
        "properties": {
          "submission_id": {
            "type": "string"
          },
          "draft_id": {
            "type": "string"
          },
          "application_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "approval_in_progress"
            ]
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "submitted_by": {
            "type": "string"
          },
          "duplicate_submission": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "approval_workflow": {
        "type": "object",
        "required": [
          "workflow_id",
          "current_step",
          "steps"
        ],
        "properties": {
          "workflow_id": {
            "type": "string"
          },
          "current_step": {
            "type": "integer",
            "minimum": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "step_number",
                "approver_role",
                "status"
              ],
              "properties": {
                "step_number": {
                  "type": "integer"
                },
                "approver_role": {
                  "type": "string"
                },
                "approver_employee_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "waiting",
                    "approved",
                    "rejected",
                    "skipped"
                  ]
                },
                "acted_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "comment": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "updated_draft_state": {
        "type": "object",
        "required": [
          "draft_id",
          "status",
          "user_confirmed",
          "submitted",
          "submission_id",
          "submitted_at"
        ],
        "properties": {
          "draft_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "approval_in_progress"
            ]
          },
          "user_confirmed": {
            "type": "boolean"
          },
          "submitted": {
            "type": "boolean"
          },
          "submission_id": {
            "type": "string"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "audit_metadata": {
        "type": "object",
        "required": [
          "session_id",
          "request_id",
          "submission_idempotency_key",
          "confirmation_text_recorded",
          "created_at"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "submission_idempotency_key": {
            "type": "string"
          },
          "confirmation_text_recorded": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "error": {
        "type": [
          "object",
          "null"
        ]
      }
    }
  },
