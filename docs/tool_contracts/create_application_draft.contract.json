{
  "tool_name": "create_application_draft",
  "version": "1.0",
  "implementation_status": "contract_only",
  "description": "根据已经收集并完成必要校验的申请数据，创建标准化申请草稿，并生成供用户确认的摘要。",
  "side_effect": "draft_write",
  "requires_user_confirmation": false,
  "supported_application_types": [
    "purchase",
    "travel_reimbursement",
    "leave",
    "expense_reimbursement"
  ],
  "preconditions": [
    "application_data必须是有效对象",
    "material_check_result必须来自check_required_materials工具",
    "material_check_result.completeness.ready_for_draft必须为true",
    "不得存在阻止创建草稿的严重数据错误",
    "user_context必须来自可信身份认证层"
  ],
  "security_rules": [
    "不得使用用户自述覆盖可信用户身份",
    "不得自动补造缺失金额、日期、供应商、预算或假期类型",
    "不得把用户未确认的草稿标记为已确认",
    "不得把草稿标记为已提交",
    "不得在草稿摘要中展示无必要的完整敏感信息",
    "医疗信息、身份证号、电话号码和账号信息应当脱敏",
    "草稿创建必须记录来源会话和请求标识",
    "同一个草稿请求重复执行时应当避免创建重复草稿"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "application_type",
      "application_data",
      "material_check_result",
      "user_context",
      "session_id",
      "request_id"
    ],
    "properties": {
      "application_type": {
        "type": "string",
        "enum": [
          "purchase",
          "travel_reimbursement",
          "leave",
          "expense_reimbursement"
        ]
      },
      "application_data": {
        "type": "object",
        "description": "已经从对话、用户资料和业务规则中整理出的申请数据",
        "additional_properties": true
      },
      "material_check_result": {
        "type": "object",
        "required": [
          "completeness",
          "missing_fields",
          "missing_materials",
          "validation_issues",
          "required_approvers"
        ],
        "properties": {
          "completeness": {
            "type": "object",
            "required": [
              "ready_for_draft",
              "ready_for_confirmation",
              "ready_for_submission"
            ],
            "properties": {
              "ready_for_draft": {
                "type": "boolean"
              },
              "ready_for_confirmation": {
                "type": "boolean"
              },
              "ready_for_submission": {
                "type": "boolean"
              }
            }
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "missing_materials": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "validation_issues": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "required_approvers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "user_context": {
        "type": "object",
        "required": [
          "employee_id",
          "employee_name",
          "department",
          "roles",
          "region"
        ],
        "properties": {
          "employee_id": {
            "type": "string"
          },
          "employee_name": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "min_items": 1
          },
          "region": {
            "type": "string"
          }
        }
      },
      "session_id": {
        "type": "string",
        "description": "创建草稿所对应的Agent会话编号"
      },
      "request_id": {
        "type": "string",
        "description": "用于日志追踪的请求编号"
      },
      "draft_idempotency_key": {
        "type": [
          "string",
          "null"
        ],
        "description": "用于防止同一次请求生成多个重复草稿",
        "default": null
      },
      "effective_date": {
        "type": [
          "string",
          "null"
        ],
        "format": "date",
        "description": "用于确定草稿适用的制度版本",
        "default": null
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "success",
      "draft",
      "draft_summary",
      "confirmation_request"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "draft": {
        "type": "object",
        "required": [
          "draft_id",
          "application_type",
          "status",
          "applicant",
          "application_data",
          "policy_snapshot",
          "required_approvers",
          "confirmation",
          "submission",
          "audit_metadata"
        ],
        "properties": {
          "draft_id": {
            "type": "string"
          },
          "application_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting_for_information",
              "waiting_for_materials",
              "waiting_for_confirmation"
            ]
          },
          "applicant": {
            "type": "object"
          },
          "application_data": {
            "type": "object"
          },
          "calculated_fields": {
            "type": "object"
          },
          "policy_snapshot": {
            "type": "object",
            "required": [
              "document_id",
              "version",
              "effective_date",
              "checked_at"
            ],
            "properties": {
              "document_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "effective_date": {
                "type": "string",
                "format": "date"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "missing_materials": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "validation_issues": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "required_approvers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confirmation": {
            "type": "object",
            "required": [
              "required",
              "user_confirmed",
              "confirmed_at"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "user_confirmed": {
                "type": "boolean"
              },
              "confirmed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "submission": {
            "type": "object",
            "required": [
              "submitted",
              "submission_id",
              "submitted_at"
            ],
            "properties": {
              "submitted": {
                "type": "boolean"
              },
              "submission_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "submitted_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "audit_metadata": {
            "type": "object",
            "required": [
              "session_id",
              "request_id",
              "created_at",
              "created_by"
            ],
            "properties": {
              "session_id": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "created_by": {
                "type": "string"
              },
              "draft_idempotency_key": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "draft_summary": {
        "type": "object",
        "required": [
          "title",
          "summary_lines",
          "warnings",
          "ready_for_confirmation"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "summary_lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ready_for_confirmation": {
            "type": "boolean"
          }
        }
      },
      "confirmation_request": {
        "type": "object",
        "required": [
          "confirmation_required",
          "confirmation_message",
          "accepted_user_intents"
        ],
        "properties": {
          "confirmation_required": {
            "type": "boolean"
          },
          "confirmation_message": {
            "type": "string"
          },
          "accepted_user_intents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "error": {
        "type": [
          "object",
          "null"
        ]
      }
    }
  },
