APP_NAME=Enterprise Policy Agent
APP_ENV=development
# 本地启动监听 127.0.0.1；Docker Compose 会在容器内覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
# Docker Compose 同时使用该值作为宿主机映射端口。
APP_PORT=8000

LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Day 23 LLM 响应缓存。本地默认关闭，避免启动必须依赖 Redis。
# 使用本机 Python 启动时，可先执行 `docker compose up redis -d`，再改为 redis。
LLM_CACHE_PROVIDER=disabled
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT_SECONDS=0.25
LLM_CACHE_TTL_SECONDS=600
# 修改命名空间版本可一次性让旧缓存失效；Redis 键只保存 SHA-256，不含原始提问。
LLM_CACHE_NAMESPACE=enterprise-policy-agent:llm:v1
LLM_CACHE_MAX_REQUEST_BYTES=262144
LLM_CACHE_MAX_VALUE_BYTES=262144
# Day 24：仅合并同一进程内、相同缓存键的并发未命中请求。
LLM_SINGLEFLIGHT_ENABLED=true
LLM_SINGLEFLIGHT_MAX_KEYS=128

# Day 27：真实 LLM 调用的进程内并发门禁；默认关闭，示例值不是生产容量结论。
LLM_PROVIDER_LIMIT_ENABLED=false
LLM_PROVIDER_MAX_CONCURRENCY=4
LLM_PROVIDER_MAX_QUEUE=16
LLM_PROVIDER_QUEUE_TIMEOUT_SECONDS=2

# Agent 工具容错层。只读和纯计算工具最多尝试 3 次；提交工具固定只尝试 1 次。
AGENT_SAFE_TOOL_TIMEOUT_SECONDS=65
AGENT_MUTATION_TOOL_TIMEOUT_SECONDS=10
AGENT_TOOL_MAX_ATTEMPTS=3
AGENT_RETRY_MIN_WAIT_SECONDS=0.1
AGENT_RETRY_MAX_WAIT_SECONDS=1.0

# Day 21 外部搜索默认关闭。只有显式改为 tavily 且配置密钥后，
# /api/v1/research/answers 的 include_web=true 才会向外部发送脱敏后的当前问题。
WEB_SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=3

# Docker Compose 会覆盖为具名卷中的绝对路径。
SQLITE_DATABASE_PATH=data/runtime/enterprise_policy_agent.db

LOG_LEVEL=INFO
