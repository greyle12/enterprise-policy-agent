APP_NAME=Enterprise Policy Agent
APP_ENV=development
# 本地启动监听 127.0.0.1；Docker Compose 会在容器内覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
# Docker Compose 同时使用该值作为宿主机映射端口。
APP_PORT=8000

LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Agent 工具容错层。只读和纯计算工具最多尝试 3 次；提交工具固定只尝试 1 次。
AGENT_SAFE_TOOL_TIMEOUT_SECONDS=65
AGENT_MUTATION_TOOL_TIMEOUT_SECONDS=10
AGENT_TOOL_MAX_ATTEMPTS=3
AGENT_RETRY_MIN_WAIT_SECONDS=0.1
AGENT_RETRY_MAX_WAIT_SECONDS=1.0

# Day 21 外部搜索默认关闭。只有显式改为 tavily 且配置密钥后，
# /api/v1/research/answers 的 include_web=true 才会向外部发送脱敏后的当前问题。
WEB_SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=3

# Docker Compose 会覆盖为具名卷中的绝对路径。
SQLITE_DATABASE_PATH=data/runtime/enterprise_policy_agent.db

LOG_LEVEL=INFO
