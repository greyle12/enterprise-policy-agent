APP_NAME=Enterprise Policy Agent
APP_ENV=development
# 本地启动监听 127.0.0.1；Docker Compose 会在容器内覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
# Docker Compose 同时使用该值作为宿主机映射端口。
APP_PORT=8000

LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Docker Compose 会覆盖为具名卷中的绝对路径。
SQLITE_DATABASE_PATH=data/runtime/enterprise_policy_agent.db

LOG_LEVEL=INFO
